---
import Icon from "./Icon.astro";

const services = [
  { name: "orders", lang: "Kotlin", tone: "bg-pink", delay: "0s" },
  { name: "billing", lang: "Rust", tone: "bg-teal", delay: "0.6s" },
  { name: "search", lang: "Go", tone: "bg-amber", delay: "1.1s" },
];
---

<section class="relative isolate overflow-hidden pb-16 pt-32 sm:pt-36 lg:pb-24 lg:pt-40">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-grid" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-radial-primary" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-70"
    data-pointer-glow
    style="background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 12%), rgba(124,108,255,0.12), transparent 62%);"
    aria-hidden="true"
  ></div>

  <div class="wrap">
    <div class="mx-auto max-w-4xl text-center">
      <a
        href="/changelog/"
        class="group inline-flex items-center gap-2 rounded-full border border-line-strong bg-white/5 px-3.5 py-1.5 font-mono text-[0.7rem] text-muted backdrop-blur transition-colors hover:border-primary/40 hover:text-white"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal opacity-60"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-teal"></span>
        </span>
        v0.6.0 is here
        <span class="text-dim">·</span>
        Apache-2.0
        <Icon name="arrow-right" size={13} class="text-dim transition-transform group-hover:translate-x-0.5" />
      </a>

      <h1 class="mt-7 text-balance text-[2.65rem] font-semibold leading-[1.02] tracking-[-0.045em] text-white sm:text-[4rem] lg:text-[4.75rem]">
        Messaging without<br class="hidden sm:block" />{" "}
        <span class="gradient-text animate-gradient">the platform in the middle.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-pretty text-[1.02rem] leading-relaxed text-muted sm:text-[1.12rem]">
        Snodra gives your services <strong class="font-medium text-white">commands, queries, events and sagas</strong>{" "}
        over the gRPC and Kafka you already run. A stateless router, a transactional outbox and a
        conformance suite — no vendor runtime, no per-node licence, no new store to operate.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/#download" class="btn btn-primary w-full sm:w-auto">
          Start in 60 seconds
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="/docs/" class="btn btn-ghost w-full sm:w-auto">
          <Icon name="book" size={16} />
          Read the docs
        </a>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-[0.68rem] text-dim">
        <span class="inline-flex items-center gap-1.5"><span class="h-1 w-1 rounded-full bg-pink"></span>Kotlin</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1 w-1 rounded-full bg-teal"></span>Rust</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1 w-1 rounded-full bg-sky-400"></span>Go</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1 w-1 rounded-full bg-amber"></span>Python</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1 w-1 rounded-full bg-primary-soft"></span>Kafka or RabbitMQ Streams</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1 w-1 rounded-full bg-lime"></span>MongoDB or SQL</span>
      </div>
    </div>

    <div class="relative mx-auto mt-14 max-w-[1050px]" data-tilt>
      <div
        class="absolute -left-8 top-10 z-10 hidden animate-float rounded-xl border border-line bg-panel/90 px-3.5 py-2.5 shadow-2xl backdrop-blur-xl lg:block"
        style="animation-delay: 0.4s"
      >
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-dim">command</p>
        <p class="mt-1 text-sm font-medium text-white">routed in one hop</p>
      </div>
      <div
        class="absolute -right-6 top-28 z-10 hidden animate-float-slow rounded-xl border border-line bg-panel/90 px-3.5 py-2.5 shadow-2xl backdrop-blur-xl lg:block"
      >
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-dim">events</p>
        <p class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-white">
          <Icon name="check" size={14} class="text-teal" />
          outbox commit
        </p>
      </div>
      <div
        class="absolute -bottom-6 right-16 z-10 hidden animate-float rounded-xl border border-line bg-panel/90 px-3.5 py-2.5 shadow-2xl backdrop-blur-xl lg:block"
        style="animation-delay: 1.2s"
      >
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-dim">sagas</p>
        <p class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-white">
          <Icon name="clock" size={14} class="text-amber" />
          deadlines built in
        </p>
      </div>

      <div data-tilt-inner class="transition-transform duration-200 will-change-transform">
        <div class="panel overflow-hidden rounded-[1.35rem] p-2 shadow-[0_40px_120px_-40px_rgba(80,60,220,0.55)] sm:p-2.5">
          <div class="overflow-hidden rounded-2xl border border-line bg-[#090711]">
            <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3 sm:px-5">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]/80"></span>
                <span class="ml-2 font-mono text-[0.66rem] text-dim">snodra-server · topology</span>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-teal/20 bg-teal/10 px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-teal">
                <span class="h-1.5 w-1.5 animate-pulse-soft rounded-full bg-teal"></span>
                live
              </span>
            </div>

            <div class="relative px-4 py-5 sm:px-6 sm:py-7">
              <div class="pointer-events-none absolute inset-0 opacity-40 [background-image:linear-gradient(to_right,rgba(255,255,255,.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,.035)_1px,transparent_1px)] [background-size:36px_36px]"></div>

              <div class="relative grid items-center gap-4 sm:grid-cols-[1fr_auto_1fr]">
                <div class="space-y-2.5">
                  {
                    services.slice(0, 2).map((service) => (
                      <div class="flex items-center justify-between rounded-xl border border-line bg-white/[0.035] px-3.5 py-3">
                        <div class="flex items-center gap-2.5">
                          <span class={`h-2 w-2 rounded-full ${service.tone}`} />
                          <div>
                            <p class="text-[0.82rem] font-medium text-white">{service.name}</p>
                            <p class="font-mono text-[0.6rem] text-dim">{service.lang} · 1 instance</p>
                          </div>
                        </div>
                        <span class="font-mono text-[0.58rem] text-teal">registered</span>
                      </div>
                    ))
                  }
                </div>

                <div class="relative mx-auto flex items-center justify-center py-2 sm:py-0">
                  <div class="absolute -inset-8 rounded-full bg-primary/15 blur-2xl" aria-hidden="true"></div>
                  <div class="relative flex min-w-[190px] flex-col items-center gap-2 rounded-2xl border border-primary/35 bg-gradient-to-b from-primary/20 to-panel px-5 py-5 shadow-glow">
                    <img src="/brand/snodra-icon.svg" alt="" width="40" height="40" class="h-10 w-10 rounded-xl" />
                    <p class="text-sm font-semibold text-white">Snodra Server</p>
                    <p class="font-mono text-[0.6rem] text-primary-soft">stateless · gRPC :7000</p>
                    <span class="mt-1 inline-flex items-center gap-1.5 rounded-full border border-line bg-black/30 px-2 py-0.5 font-mono text-[0.56rem] text-dim">
                      <span class="h-1 w-1 rounded-full bg-teal"></span>routing
                    </span>
                  </div>
                </div>

                <div class="space-y-2.5">
                  {
                    services.slice(2).map((service) => (
                      <div class="flex items-center justify-between rounded-xl border border-line bg-white/[0.035] px-3.5 py-3">
                        <div class="flex items-center gap-2.5">
                          <span class={`h-2 w-2 rounded-full ${service.tone}`} />
                          <div>
                            <p class="text-[0.82rem] font-medium text-white">{service.name}</p>
                            <p class="font-mono text-[0.6rem] text-dim">{service.lang} · 1 instance</p>
                          </div>
                        </div>
                        <span class="font-mono text-[0.58rem] text-teal">registered</span>
                      </div>
                    ))
                  }
                  <div class="flex items-center justify-between rounded-xl border border-dashed border-line bg-white/[0.02] px-3.5 py-3">
                    <div class="flex items-center gap-2.5">
                      <span class="h-2 w-2 rounded-full bg-primary-soft/60"></span>
                      <div>
                        <p class="text-[0.82rem] font-medium text-white/80">python</p>
                        <p class="font-mono text-[0.6rem] text-dim">next client</p>
                      </div>
                    </div>
                    <span class="font-mono text-[0.58rem] text-dim">soon</span>
                  </div>
                </div>
              </div>

              <div class="relative mt-5 grid gap-2 sm:grid-cols-3">
                {
                  [
                    ["message store", "outbox · markers · sagas", "bg-lime"],
                    ["event store", "Kafka or RabbitMQ Streams", "bg-amber"],
                    ["processors", "idempotent · dead letters", "bg-pink"],
                  ].map(([title, detail, tone]) => (
                    <div class="flex items-center gap-2.5 rounded-lg border border-line bg-white/[0.025] px-3 py-2.5">
                      <span class={`h-1.5 w-1.5 rounded-full ${tone}`} />
                      <div>
                        <p class="text-[0.72rem] font-medium text-white">{title}</p>
                        <p class="font-mono text-[0.56rem] text-dim">{detail}</p>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="flex flex-col gap-2 border-t border-line bg-black/30 px-4 py-3 font-mono text-[0.66rem] text-dim sm:flex-row sm:items-center sm:justify-between sm:px-5">
              <span class="flex items-center gap-2">
                <span class="text-primary-soft">$</span>
                <span class="text-white/80">docker run -p 7000:7000 -p 7001:7001 snodra/snodra-server:0.6.0</span>
                <span class="cursor-blink text-primary-soft">▍</span>
              </span>
              <span class="flex items-center gap-3">
                <span><span class="text-white">3</span> instances</span>
                <span><span class="text-white">12</span> types</span>
                <span><span class="text-white">0</span> queues</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-4">
      {
        [
          ["0", "brokers in the request path"],
          ["3", "production clients"],
          ["4", "store add-ons"],
          ["1", "protocol"],
        ].map(([value, label]) => (
          <div class="rounded-xl border border-line bg-white/[0.025] px-4 py-3 text-center">
            <p class="text-2xl font-semibold tracking-tight text-white" data-count={value}>{value}</p>
            <p class="mt-0.5 text-[0.72rem] leading-snug text-dim">{label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
