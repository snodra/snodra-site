---
import Icon from "./Icon.astro";

const links = [
  { label: "Features", href: "/#features" },
  { label: "Download", href: "/#download" },
  { label: "Changelog", href: "/changelog/" },
  { label: "Docs", href: "/docs/" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="wrap">
    <div
      id="nav-shell"
      class="mt-3 flex items-center justify-between gap-4 rounded-xl border border-transparent px-3 py-2.5 transition-all duration-300 sm:px-4"
    >
      <a href="/" class="group flex items-center gap-2.5" aria-label="Snodra home">
        <img
          src="/brand/snodra-icon.svg"
          alt=""
          width="32"
          height="32"
          class="h-8 w-8 rounded-lg shadow-lg shadow-primary/20 transition-transform duration-300 group-hover:-rotate-3"
        />
        <span class="text-[1.02rem] font-semibold tracking-tight text-white">Snodra</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-[0.86rem] font-medium text-muted transition-colors hover:bg-white/5 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="https://github.com/snodra"
          class="rounded-lg px-3 py-2 text-[0.86rem] font-medium text-muted transition-colors hover:bg-white/5 hover:text-white"
          rel="noopener"
        >
          <span class="inline-flex items-center gap-1.5">GitHub <Icon name="arrow-up-right" size={13} /></span>
        </a>
      </nav>

      <div class="hidden items-center gap-2 md:flex">
        <a href="/docs/getting-started/" class="btn btn-primary !min-h-9 !px-3.5 !py-2 !text-[0.82rem]">
          Get started
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="grid h-10 w-10 place-items-center rounded-lg border border-line-strong bg-white/5 text-white md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>

    <div
      id="mobile-menu"
      class="mb-3 hidden rounded-xl border border-line bg-panel/95 p-2 shadow-2xl backdrop-blur-xl md:hidden"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium text-muted hover:bg-white/5 hover:text-white"
          >
            {link.label}
            <Icon name="arrow-right" size={14} />
          </a>
        ))
      }
      <a
        href="https://github.com/snodra"
        class="flex items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium text-muted hover:bg-white/5 hover:text-white"
        rel="noopener"
      >
        GitHub
        <Icon name="arrow-up-right" size={14} />
      </a>
      <a href="/docs/getting-started/" class="btn btn-primary mt-2 w-full !py-3 !text-sm">
        Get started
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </div>
</header>
