---
import Icon from "./Icon.astro";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Server", href: "https://github.com/snodra/snodra-server" },
      { label: "Messaging", href: "https://github.com/snodra/snodra-messaging" },
      { label: "Event Browser", href: "https://github.com/snodra/snodra-event-browser" },
      { label: "Conformance", href: "https://github.com/snodra/snodra-conformance" },
      { label: "Changelog", href: "/changelog/" },
    ],
  },
  {
    title: "Documentation",
    links: [
      { label: "Getting started", href: "/docs/getting-started/" },
      { label: "Core concepts", href: "/docs/concepts/" },
      { label: "Server reference", href: "/docs/server/" },
      { label: "Kotlin library", href: "/docs/messaging/kotlin/" },
      { label: "Rust library", href: "/docs/messaging/rust/" },
    ],
  },
  {
    title: "Open source",
    links: [
      { label: "GitHub organization", href: "https://github.com/snodra" },
      { label: "Releases", href: "https://github.com/snodra/snodra-server/releases" },
      { label: "Contributing", href: "https://github.com/snodra/snodra-site/blob/main/CONTRIBUTING.md" },
      { label: "Apache-2.0 licence", href: "https://github.com/snodra/snodra-server/blob/main/LICENSE" },
    ],
  },
];
---

<footer class="relative mt-24 border-t border-line bg-ink-soft/60">
  <div class="wrap py-14">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="Snodra home">
          <img src="/brand/snodra-icon.svg" alt="" width="34" height="34" class="h-9 w-9 rounded-lg" />
          <span class="text-lg font-semibold tracking-tight">Snodra</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          Commands, queries, events and sagas for services that speak gRPC and Kafka.
          Self-hosted, open source, and out of the request path when it should be.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="chip"><span class="h-1.5 w-1.5 rounded-full bg-teal"></span>Apache-2.0</span>
          <span class="chip">Self-hosted</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          columns.map((column) => (
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-dim">{column.title}</p>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex items-center gap-1.5 text-[0.84rem] text-muted transition-colors hover:text-white"
                    >
                      {link.label}
                      {link.href.startsWith("http") && (
                        <Icon
                          name="arrow-up-right"
                          size={11}
                          class="opacity-0 transition-opacity group-hover:opacity-100"
                        />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-[0.78rem] text-dim sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Snodra. Apache-2.0 licensed.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="https://github.com/snodra" class="transition-colors hover:text-white" rel="noopener">
          github.com/snodra
        </a>
        <a href="https://snodra.damoreira.com/docs/" class="transition-colors hover:text-white">Documentation</a>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 animate-pulse-soft rounded-full bg-teal"></span>
          Building in the open
        </span>
      </div>
    </div>
  </div>
</footer>
