---
import Icon from "./Icon.astro";
import { releases, accentClasses } from "../data/releases";

const latest = releases.slice(0, 4);
---

<section class="relative py-20 sm:py-28">
  <div class="wrap">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="eyebrow">Changelog</p>
        <h2 class="mt-4 text-balance text-3xl font-semibold leading-[1.08] tracking-[-0.03em] text-white sm:text-[2.7rem]">
          Shipping in the open.<br />
          <span class="text-muted">Every release, tagged.</span>
        </h2>
      </div>
      <a href="/changelog/" class="btn btn-ghost !min-h-9 !px-3.5 !py-2 !text-[0.8rem]">
        All releases
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="mt-10 overflow-hidden rounded-2xl border border-line">
      {
        latest.map((release, index) => {
          const accent = accentClasses[release.accent];
          return (
            <a
              href={release.href}
              class="group grid gap-3 border-b border-line bg-white/[0.02] px-5 py-4 transition-colors last:border-0 hover:bg-white/[0.045] sm:grid-cols-[190px_1fr_auto] sm:items-center sm:gap-5 sm:px-6"
              data-reveal
              style={`--reveal-delay: ${index * 45}ms`}
              rel="noopener"
            >
              <div class="flex items-center gap-2.5">
                <span class={`h-1.5 w-1.5 rounded-full ${accent.dot}`} />
                <div>
                  <p class="text-[0.82rem] font-medium text-white">{release.project}</p>
                  <p class="font-mono text-[0.62rem] text-dim">{release.date}</p>
                </div>
              </div>
              <p class="text-[0.8rem] leading-relaxed text-muted">{release.summary}</p>
              <span class="inline-flex items-center gap-2 justify-self-start sm:justify-self-end">
                <span class={`rounded-full border px-2 py-0.5 font-mono text-[0.62rem] ${accent.ring} ${accent.text}`}>
                  v{release.version}
                </span>
                <Icon name="arrow-up-right" size={13} class="text-dim transition-colors group-hover:text-white" />
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
